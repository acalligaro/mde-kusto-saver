{
  "manifest_version": 3,
  "name": "MDE Kusto Saver",
  "version": "0.1.0",
  "description": "Bibliothèque locale de requêtes KQL pour la chasse avancée Microsoft Defender : enregistrer, rechercher, recharger.",
  "author": "Alexandre Calligaro",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["https://security.microsoft.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "MDE Kusto Saver", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_ui": { "page": "popup.html", "open_in_tab": true }
}
